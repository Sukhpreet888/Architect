{
  "name": "archflow",
  "version": "1.0.0",
  "description": "ARCHFLOW - practice & project management SaaS for architecture firms (email-only reminders)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
