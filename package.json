    "@supabase/supabase-js": "^2.119.0",
    "@vercel/functions": "^3.11.3",
    "cookie-session": "^2.1.1",
    "ejs": "^7.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  }
}
