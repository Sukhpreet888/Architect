<%- include('../partials/head') %>
<div class="grid g2">
<div class="card">
  <% const inTrial = sub.onTrial && !sub.expired && sub.trialDaysLeft >= 0; %>
  <h2><%= inTrial ? 'Choose' : 'Activate' %> the <%= plan.name %> plan</h2>
  <% if (inTrial) { %><div class="flash success">You're on your free trial (<%= sub.trialDaysLeft %> day<%= sub.trialDaysLeft === 1 ? '' : 's' %> left). <b>No card needed now</b> — you'll be asked for card details when the trial ends on <%= fmtDate(org.trial_ends_at) %>. You can add one now if you prefer.</div>
  <% } else { %><div class="flash error">Your free trial has ended. Add your card details to activate the plan and continue using ARCHFLOW.</div><% } %>
  <form method="post" action="/billing/checkout">
    <input type="hidden" name="plan" value="<%= plan.key %>"><input type="hidden" name="onboarding" value="<%= onboarding ? 1 : 0 %>">
    <% if (plan.key === 'enterprise') { %>
      <div class="row"><div><label>Users</label><input type="number" name="custom_users" min="1" value="50"></div>
      <div><label>Active projects</label><input type="number" name="custom_projects" min="1" value="200"></div>
      <div><label>Storage (GB)</label><input type="number" name="custom_storage_gb" min="1" value="500"></div></div>
      <p class="muted small">Enterprise pricing is agreed with sales; limits apply immediately.</p>
    <% } %>
    <% if (org.card_last4) { %><label><input type="checkbox" name="use_saved" value="1" checked> Use saved <%= org.card_brand %> •••• <%= org.card_last4 %></label><% } %>
    <label>Card number <% if (inTrial) { %><span class="muted">(optional during the trial)</span><% } %></label><input name="card_number" inputmode="numeric" placeholder="4242 4242 4242 4242" <%= inTrial || org.card_last4 ? '' : 'required' %>>
    <div class="row"><div><label>Expiry (MM/YY)</label><input name="card_expiry" placeholder="12/29"></div><div><label>CVC</label><input name="card_cvc" placeholder="123"></div></div>
    <p class="muted small">Demo payment gateway: any card works except numbers ending in 0002 (declined).</p>
    <p><button class="btn"><%= inTrial ? 'Continue with ' + plan.name : 'Add card & activate' %></button> <a class="btn grey" href="<%= onboarding ? '/onboarding/plan' : '/billing/plans' %>">Choose another plan</a></p>
  </form>
</div>
<div class="card">
  <h2>Summary</h2>
  <table><tr><td>Plan</td><td class="right"><b><%= plan.name %></b></td></tr>
  <tr><td>Price</td><td class="right"><%= plan.price ? '$' + plan.price + '/month' : 'Custom' %></td></tr>
  <tr><td>Users in use</td><td class="right"><%= usage.users %><%= plan.users ? ' / ' + plan.users : '' %></td></tr>
  <tr><td>Active projects</td><td class="right"><%= usage.projects %><%= plan.projects ? ' / ' + plan.projects : '' %></td></tr>
  <tr><td>First charge</td><td class="right"><%= sub.onTrial && !sub.expired ? fmtDate(org.trial_ends_at) + ' (end of trial)' : 'Today' %></td></tr></table>
</div>
</div>
<%- include('../partials/foot') %>
