<%- include('../partials/head') %>
<%- include('nav') %>
<div class="card" style="max-width:720px"><h2>Create invoice</h2>
<form method="post" action="/payments/invoices">
  <label>Project</label><select name="project_id" required><option value="">Select project…</option><% projects.forEach(p => { %><option value="<%= p.id %>" <%= inv.project_id===p.id?'selected':'' %>><%= p.code %> · <%= p.name %><%= p.client_email ? '' : ' (no client email!)' %></option><% }) %></select>
  <label>Milestone</label><input name="milestone" placeholder="e.g. 20% on concept approval" required>
  <div class="row"><div><label>Amount (<%= org.currency %>)</label><input type="number" step="0.01" min="0.01" name="amount" required></div><div><label>Tax</label><input type="number" step="0.01" min="0" name="tax" value="<%= inv.tax %>"></div></div>
  <div class="row"><div><label>Issue date</label><input type="date" name="issue_date" value="<%= inv.issue_date %>"></div><div><label>Due date</label><input type="date" name="due_date" value="<%= inv.due_date %>" required></div></div>
  <label>Notes / payment instructions</label><textarea name="notes"></textarea>
  <p><button class="btn" name="action" value="issue">Issue & email to client</button> <button class="btn grey" name="action" value="draft">Save draft</button></p>
</form></div>
<%- include('../partials/foot') %>
