<%- include('../partials/head') %>
<%- include('nav') %>
<div class="grid g2">
<% if (can('invoice_manage')) { %>
<div class="card"><h2>Record payment</h2>
<form method="post" action="/payments/transactions" enctype="multipart/form-data">
  <label>Invoice</label><select name="invoice_id" required><option value="">Select invoice…</option><% open.forEach(i => { %><option value="<%= i.id %>" <%= preselect===i.id?'selected':'' %>><%= i.number %> · <%= i.project_name %> · balance <%= money(i.balance) %></option><% }) %></select>
  <div class="row"><div><label>Amount</label><input type="number" step="0.01" min="0.01" name="amount" required></div><div><label>Date</label><input type="date" name="paid_on" value="<%= U.today() %>"></div></div>
  <div class="row"><div><label>Method</label><select name="method"><% Object.entries(C.PAYMENT_METHODS).forEach(([k,v]) => { %><option value="<%= k %>"><%= v %></option><% }) %></select></div><div><label>Reference</label><input name="reference"></div></div>
  <label>Proof</label><input type="file" name="proof">
  <p><button class="btn green">Record payment</button> <span class="muted small">Partial or full. Receipt emailed to client & team.</span></p>
</form></div><% } %>
<div class="card" style="<%= can('invoice_manage') ? '' : 'grid-column:span 2' %>"><h2>Transactions</h2>
<div class="tablewrap"><table><tr><th>Date</th><th>Invoice</th><th>Method</th><th>Reference</th><th class="right">Amount</th><th>Proof</th></tr>
<% rows.forEach(r => { %><tr><td class="nowrap"><%= fmtDate(r.paid_on) %></td><td><a href="/payments/invoices/<%= r.invoice_id %>"><%= r.number %></a><div class="muted small"><%= r.project_name %></div></td><td><%= C.PAYMENT_METHODS[r.method] %></td><td><%= r.reference || '—' %></td><td class="right"><%= money(r.amount) %></td><td><%- r.proof_name ? `<a href="/payments/transactions/${r.id}/proof">File</a>` : '—' %></td></tr><% }) %>
<% if (!rows.length) { %><tr><td colspan="6" class="empty">No transactions.</td></tr><% } %></table></div></div>
</div>
<%- include('../partials/foot') %>
