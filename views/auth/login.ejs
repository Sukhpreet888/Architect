<%- include('../partials/head') %>
<div class="card">
  <h2>Sign in</h2>
  <form method="post" action="/login">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Email</label><input type="email" name="email" value="<%= locals.email || '' %>" required autofocus>
    <label>Password</label><input type="password" name="password" required>
    <p><button class="btn" style="width:100%;justify-content:center">Sign in</button></p>
  </form>
  <p class="muted small"><a href="/forgot">Forgot password?</a> · New to ARCHFLOW? <a href="/register">Create an account</a></p>
</div>
<%- include('../partials/foot') %>
