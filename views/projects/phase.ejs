<%- include('../partials/head') %>
<%- include('../partials/project-nav') %>
<% const open = project.status === 'active'; const base = `/projects/${project.id}`; %>
<div class="head"><div><div class="muted small">Phase <%= phase.seq %> of <%= allPhases.length %></div><h2 style="margin:0"><%= phase.name %> <%- badge(phase.status === 'na' ? 'cancelled' : phase.status, phase.status === 'na' ? 'Not applicable' : null) %></h2>
<div class="muted small">Planned <%= fmtDate(phase.planned_start) %> → <%= fmtDate(phase.planned_end) %><%= phase.completed_at ? ' · completed ' + fmtDate(phase.completed_at) : '' %></div></div>
<% if (open && can('project_manage')) { %><div class="nowrap">
  <% if (['in_progress','in_review'].includes(phase.status)) { %><form class="inline" method="post" action="<%= base %>/phases/<%= phase.id %>/status" data-confirm="Mark this phase complete without review?"><input type="hidden" name="action" value="complete"><button class="btn sm grey">Mark phase complete</button></form><% } %>
  <% if (phase.status === 'not_started') { %><form class="inline" method="post" action="<%= base %>/phases/<%= phase.id %>/status"><input type="hidden" name="action" value="start"><button class="btn sm ghost">Start phase</button></form><% } %>
  <% if (phase.status === 'completed') { %><form class="inline" method="post" action="<%= base %>/phases/<%= phase.id %>/status"><input type="hidden" name="action" value="reopen"><button class="btn sm grey">Re-open</button></form><% } %>
  <% if (['na','not_started'].includes(phase.status)) { %><form class="inline" method="post" action="<%= base %>/phases/<%= phase.id %>/status"><input type="hidden" name="action" value="toggle_na"><button class="btn sm grey"><%= phase.status === 'na' ? 'Mark applicable' : 'Mark not applicable' %></button></form><% } %>
</div><% } %></div>

<% if (phase.status === 'in_progress' && open && can('phase_submit')) { %>
<div class="card" style="border-color:#8ab8f2">
  <h2>Submit phase for internal review</h2>
  <% const openTasks = tasks.filter(t => t.status !== 'done').length; if (openTasks) { %><p class="small" style="color:var(--amber)"><%= openTasks %> task(s) in this phase are still open.</p><% } %>
  <% if (review) { %><p class="small">Previous review: <%- badge(review.status) %> (round <%= review.round %>) — <a href="<%= base %>/approvals/<%= review.id %>">see comments</a>. Submitting starts a new review round.</p><% } %>
  <form method="post" action="<%= base %>/phases/<%= phase.id %>/submit-review">
    <label>Reviewers</label><div class="row"><% team.filter(m => m.id !== user.id).forEach(m => { %><label style="font-weight:400;flex:0 0 auto"><input type="checkbox" name="reviewers" value="<%= m.id %>" <%= ['admin','pm','lead_architect'].includes(m.role) ? 'checked' : '' %>> <%= m.name %> <span class="muted small"><%= C.ROLES[m.role] || '' %></span></label><% }) %></div>
    <label>Note to reviewers</label><textarea name="note" style="min-height:50px"></textarea>
    <p><button class="btn">Submit for internal review</button></p>
  </form>
</div>
<% } else if (phase.status === 'in_review' && review) { %>
<div class="flash success">Phase is in internal review — <a href="<%= base %>/approvals/<%= review.id %>">open review (round <%= review.round %>)</a>. When approved, the phase is marked complete and the next phase opens.</div>
<% } %>

<div class="grid g2">
<div class="card"><h2>Subphases, tasks & deliverables</h2>
  <% const canTick = open && can('task_manage'); %>
  <% const tickBox = (t) => { const done = t.status === 'done';
       const box = `<span class="tick ${done ? 'on' : ''}" aria-hidden="true">${done ? '✓' : ''}</span>`;
       return canTick ? `<form class="inline" method="post" action="${base}/tasks/${t.id}"><input type="hidden" name="status" value="${done ? 'todo' : 'done'}"><button class="tick-btn" title="${done ? 'Mark as not done' : 'Mark as done'}" aria-label="${done ? 'Mark as not done' : 'Mark as done'}: ${esc(t.title)}">${box}</button></form>` : box; }; %>
  <% subphases.forEach(sp => { const spTasks = tasks.filter(t => t.subphase_id === sp.id); const spDone = spTasks.length > 0 && spTasks.every(t => t.status === 'done'); %>
    <h3 class="subphase-head"><span class="tick <%= spDone ? 'on' : '' %>" aria-hidden="true"><%= spDone ? '✓' : '' %></span> <%= sp.name %>
      <span class="muted small" style="font-weight:400"><%= spTasks.filter(t => t.status === 'done').length %>/<%= spTasks.length %> tasks done<%= spDone ? ' · completed' : '' %></span></h3>
    <table class="small">
    <% spTasks.forEach(t => { %><tr class="<%= t.status === 'done' ? 'task-done' : '' %>"><td><%- tickBox(t) %> <a href="<%= base %>/tasks/<%= t.id %>"><%= t.title %></a></td><td><%= t.assignee || 'Unassigned' %></td><td class="nowrap"><%= fmtDate(t.due_date) %></td><td><%- badge(t.status) %></td></tr><% }) %>
    <% deliverables.filter(d => d.subphase_id === sp.id).forEach(d => { %><tr><td colspan="2">📄 <b><%= d.name %></b> <span class="muted">deliverable</span></td><td class="nowrap"><%= fmtDate(d.due_date) %></td>
      <td><% if (open && can('task_manage') && d.status !== 'approved') { %><form method="post" action="<%= base %>/deliverables/<%= d.id %>"><select name="status" onchange="this.form.submit()"><% ['pending','in_progress','submitted'].concat(can('project_manage') ? ['approved'] : []).forEach(s => { %><option value="<%= s %>" <%= d.status===s?'selected':'' %>><%= s.replace('_',' ') %></option><% }) %><% if (d.status === 'revision_required') { %><option selected>revision required</option><% } %></select></form><% } else { %><%- badge(d.status) %><% } %></td></tr><% }) %>
    </table>
  <% }) %>
  <% const loose = tasks.filter(t => !t.subphase_id); if (loose.length) { %><h3>Other tasks</h3><table class="small"><% loose.forEach(t => { %><tr class="<%= t.status === 'done' ? 'task-done' : '' %>"><td><%- tickBox(t) %> <a href="<%= base %>/tasks/<%= t.id %>"><%= t.title %></a></td><td><%= t.assignee || '—' %></td><td><%- badge(t.status) %></td></tr><% }) %></table><% } %>
  <% if (open && can('task_manage')) { %>
  <details style="margin-top:12px"><summary>+ Add subphase / task / deliverable</summary>
    <form method="post" action="<%= base %>/phases/<%= phase.id %>/subphases" class="row" style="margin-top:8px"><input name="name" placeholder="New subphase name"><div style="flex:0"><button class="btn sm">Add subphase</button></div></form>
    <form method="post" action="<%= base %>/tasks" style="margin-top:8px"><input type="hidden" name="phase_id" value="<%= phase.id %>">
      <div class="row"><input name="title" placeholder="Task title" required><select name="assignee_id"><option value="">Unassigned</option><% team.forEach(m => { %><option value="<%= m.id %>"><%= m.name %></option><% }) %></select><input type="date" name="due_date" value="<%= phase.planned_end || '' %>"><select name="priority"><% Object.entries(C.PRIORITIES).forEach(([k,v]) => { %><option value="<%= k %>" <%= k==='medium'?'selected':'' %>><%= v %></option><% }) %></select><div style="flex:0"><button class="btn sm">Add task</button></div></div>
      <input type="hidden" name="subphase_id" value="">
    </form>
    <form method="post" action="<%= base %>/phases/<%= phase.id %>/deliverables" class="row" style="margin-top:8px"><input name="name" placeholder="Deliverable name" required><select name="subphase_id"><% subphases.forEach(sp => { %><option value="<%= sp.id %>"><%= sp.name %></option><% }) %></select><input type="date" name="due_date"><div style="flex:0"><button class="btn sm">Add deliverable</button></div></form>
  </details><% } %>
</div>
<div>
  <div class="card"><h2>Phase documents</h2>
    <% documents.forEach(d => { %><div style="padding:4px 0;border-bottom:1px solid var(--line)"><a href="<%= base %>/documents/<%= d.id %>"><%= d.title %></a> <span class="badge">R<%= d.rev %></span></div><% }) %>
    <% if (!documents.length) { %><div class="muted">No documents uploaded for this phase.</div><% } %>
    <% if (open && can('doc_upload')) { %>
    <form method="post" action="<%= base %>/documents" enctype="multipart/form-data" style="margin-top:10px">
      <input type="hidden" name="phase_id" value="<%= phase.id %>">
      <div class="row"><input name="title" placeholder="Title (optional)"><select name="deliverable_id"><option value="">Link to deliverable…</option><% deliverables.forEach(d => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select></div>
      <div class="row" style="margin-top:8px"><input type="file" name="file" required><div style="flex:0"><button class="btn sm">Upload</button></div></div>
    </form><% } %>
  </div>
  <div class="card"><h2>Approvals in this phase</h2>
    <% approvals.forEach(a => { %><div style="padding:4px 0;border-bottom:1px solid var(--line)"><a href="<%= base %>/approvals/<%= a.id %>"><%= a.title %></a> <%- badge(a.status) %></div><% }) %>
    <% if (!approvals.length) { %><div class="muted">None.</div><% } %>
    <p><a href="<%= base %>/approvals">Create approval request →</a></p>
  </div>
</div></div>
<%- include('../partials/foot') %>
