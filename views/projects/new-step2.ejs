<%- include('../partials/head') %>
<h1>Create new project</h1><p class="muted"><b>Step 2 of 2:</b> Project information — <%= C.PROJECT_TYPES[draft.type].name %> · <%= draft.subtype %> · plot <%= draft.plot_area %> <%= C.AREA_UNITS[draft.area_unit] %> <a href="/projects/new" class="small">(change)</a></p>
<form method="post" action="/projects">
<div class="grid g2">
<div class="card">
  <h2>Project details</h2>
  <label>Project name</label><input name="name" required>
  <label>Location / site address</label><input name="location">
  <label>Description</label><textarea name="description"></textarea>
  <div class="row"><div><label>Start date</label><input type="date" name="start_date" value="<%= form.start_date %>"></div><div><label>Target end date</label><input type="date" name="end_date"></div></div>
  <label>Contract / fee value <span class="muted">(<%= org.currency %>)</span></label><input type="number" step="any" min="0" name="contract_value">
  <h2 style="margin-top:18px">Client</h2>
  <label>Client name</label><input name="client_name">
  <div class="row"><div><label>Client email <span class="muted">(invoices & reminders)</span></label><input type="email" name="client_email"></div><div><label>Client phone</label><input name="client_phone"></div></div>
</div>
<div class="card">
  <h2>Execution scope</h2>
  <% Object.entries(C.SCOPES).forEach(([k,v]) => { %><label style="font-weight:400"><input type="radio" name="scope" value="<%= k %>" <%= form.scope===k?'checked':'' %> onchange="document.getElementById('budget').style.display = this.value==='design_construction' ? '' : 'none'"> <%= v %></label><% }) %>
  <div id="budget" style="display:none"><label>Construction budget <span class="muted">(<%= org.currency %>)</span></label><input type="number" step="any" min="0" name="construction_budget"></div>
  <label>Workflow template</label><select name="template_id"><% templates.forEach(t => { %><option value="<%= t.id %>"><%= t.name %> (v<%= t.version %>)</option><% }) %></select>
  <h2 style="margin-top:18px">Team</h2>
  <label>Project manager</label><select name="manager_id"><% members.forEach(m => { %><option value="<%= m.id %>" <%= m.id===form.manager_id?'selected':'' %>><%= m.name %> — <%= C.ROLES[m.role] %></option><% }) %></select>
  <label>Team members</label>
  <% members.forEach(m => { %><label style="font-weight:400;margin:4px 0"><input type="checkbox" name="members" value="<%= m.id %>" <%= m.id===user.id?'checked':'' %>> <%= m.name %> <span class="muted small"><%= C.ROLES[m.role] %></span></label><% }) %>
</div></div>
<p><button class="btn">Create project & generate workflow</button></p>
</form>
<%- include('../partials/foot') %>
