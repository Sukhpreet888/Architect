# Copy to .env (or export in your shell) and adjust.
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
# Where the SQLite database and uploads live
DATA_DIR=./data

# ---- Email (the ONLY notification/reminder channel) ----
# If SMTP_HOST is empty, emails are written to the Email Log (and console) instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ARCHFLOW <no-reply@archflow.app>"
SALES_EMAIL=sales@archflow.app

# How often (minutes) the email reminder scheduler runs
REMINDER_INTERVAL_MINUTES=60
