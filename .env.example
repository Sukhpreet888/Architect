# Copy to .env (or export in your shell) and adjust.
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
# Local working folder (temporary upload files; embedded database when DATABASE_URL is empty)
DATA_DIR=./data

# ---- Supabase ----
# Database: Supabase Dashboard -> your project -> Connect -> "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with the database password. Leave empty to use an embedded local Postgres instead.
DATABASE_URL=postgresql://postgres.lqhyqkhlwlsxoazousif:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# File storage (drawings, documents, payment proofs): Dashboard -> Project Settings -> API Keys.
# The service_role / secret key is server-only: never put it in browser code or commit it.
SUPABASE_URL=https://lqhyqkhlwlsxoazousif.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=archflow-files

# ---- Email (the ONLY notification/reminder channel) ----
# If SMTP_HOST is empty, emails are written to the Email Log (and console) instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ARCHFLOW <no-reply@archflow.app>"
SALES_EMAIL=sales@archflow.app

# How often (minutes) the email reminder scheduler runs
REMINDER_INTERVAL_MINUTES=60
